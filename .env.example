# ============================================================
# InterviewGPT Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# -------- Backend (apps/api) --------
# Server port (default 8000)
API_PORT=8000

# CORS origins (comma-separated). Add your deployed web URL in production.
CORS_ORIGINS=http://localhost:3000

# Path to ChromaDB persistent storage (relative to apps/api)
CHROMA_PERSIST_DIR=./chroma_data

# Embedding model for ChromaDB (uses default sentence-transformers if unset)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Default model used when the client does not specify one. The backend
# speaks the OpenAI Chat Completions protocol, so any OpenAI-compatible
# model ID works (gpt-4o-mini, deepseek-chat, qwen-plus, claude-...).
DEFAULT_MODEL=gpt-4o-mini

# Optional: server-side fallback API key (only used if BYOK header missing).
# In open-source / hosted demo we recommend leaving this blank to enforce BYOK.
# LLM_API_KEY=

# Session store backend: "memory" (process-local, lost on restart, zero-config)
# or "redis" (durable, survives redeploys). docker-compose defaults to redis.
SESSION_STORE_BACKEND=memory
SESSION_REDIS_URL=redis://localhost:6379/0
# Idle TTL in seconds. After this much inactivity the session is dropped.
SESSION_TTL_SECONDS=3600

# -------- Frontend (apps/web) --------
# Public API URL the browser uses to reach the backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# -------- Seed generation script (scripts/generate-seeds.ts) --------
# Used only when running `pnpm seeds:generate` locally
ANTHROPIC_API_KEY_FOR_SEEDS=
